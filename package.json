    "drizzle-orm": "^0.44.5",
    "leaflet": "^1.9.4",
    "next": "15.5.20",
    "next-auth": "5.0.0-beta.25",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "resend": "^4.1.2"
  },
  "devDependencies": {
