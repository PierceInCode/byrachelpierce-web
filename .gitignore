# Dependencies
node_modules/

# Next.js build output
.next/
out/

# Lighthouse CI generated audit output (LHRs, assertion results, links)
.lighthouseci/

# Environment variables — NEVER commit these
.env
.env.local
.env.production
.env.*.local

# OS files
.DS_Store
Thumbs.db

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# TypeScript build info
*.tsbuildinfo
next-env.d.ts

# Runtime data (auth sessions, trail progress JSON files)
# These are generated at runtime and should not be committed.
data/

# Vercel
.vercel

# Art image binaries — served from Vercel Blob (Architecture s6); source of truth
# is the operator's local folder + external backup. NEVER commit these.
public/art/

# Local file databases (dev/CI/test) and DB backups
*.db
*.db-journal
backups/

# R4 content-intake pre-fill sheet — regenerated from the DB by
# scripts/export-catalog-csv.ts (authoritative run is against production).
# Must not be committed from a build session with dev-DB data (DECISIONS 031).
# The ingest REPORTS (ingest-report-*.md) and the murals.csv template ARE
# committed (Spec §9.2), so ignore only this generated sheet.
docs/intake/paintings.csv

# Vitest coverage output
coverage/

# Playwright output
playwright-report/
test-results/

# Claude Code local (per-machine) settings — the shared harness IS committed
.claude/settings.local.json
.env*
byrachelpierce-web.lnk
