# Dependencies
node_modules/

# Next.js build output
.next/
out/

# Environment variables — NEVER commit these
.env
.env.local
.env.production
.env.*.local

# OS files
.DS_Store
Thumbs.db

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# TypeScript build info
*.tsbuildinfo
next-env.d.ts

# Runtime data (auth sessions, trail progress JSON files)
# These are generated at runtime and should not be committed.
data/

# Vercel
.vercel

# Art image binaries — served from Vercel Blob (Architecture s6); source of truth
# is the operator's local folder + external backup. NEVER commit these.
public/art/

# Local file databases (dev/CI/test) and DB backups
*.db
*.db-journal
backups/

# Vitest coverage output
coverage/

# Playwright output
playwright-report/
test-results/

# Claude Code local (per-machine) settings — the shared harness IS committed
.claude/settings.local.json
.env*
